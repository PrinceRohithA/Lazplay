PORT=3000
NODE_ENV=development

# Frontend origin for CORS and callback redirects
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# JWT
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=2h

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:Prince%4018@localhost:5432/lazplay
DB_AUTO_INIT=true
DB_AUTO_SEED=true

# Storage
GAME_STORAGE_DIR=./storage/games
MAX_UPLOAD_SIZE_MB=2048

# OAuth (mocked for local development)
MOCK_OAUTH_ENABLED=true
MOCK_OAUTH_PROVIDER=mock
MOCK_OAUTH_EMAIL=player1@lazplay.local
MOCK_OAUTH_NAME=Player One
MOCK_OAUTH_ROLE=player
ADMIN_EMAILS=admin@lazplay.local
