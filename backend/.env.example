# ─── LazPlay Backend — Production Environment ─────────────────────────────────
# Copy this to .env on the server and fill in real secrets.

PORT=2000
APP_ENV=production
APP_VERSION=1.0.0

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://lazplay:Prince%4018@localhost:5432/lazplay


# API prefix — nginx strips /api/ before proxying, so backend sees /v1/
API_PREFIX=/v1

# Public URLs
PUBLIC_API_URL=https://play.lazplay.tech/api/v1
PUBLIC_WEB_URL=https://play.lazplay.tech

# Auth — CHANGE THIS TO A LONG RANDOM STRING IN PRODUCTION
AUTH_SECRET=change-this-to-a-long-random-secret

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
RUNTIME_TOKEN_TTL_SECONDS=900

# MinIO — CDN proxy at cdn.lazplay.tech (port 2002 internally)
MINIO_PUBLIC_URL=https://cdn.lazplay.tech
MINIO_BUCKET=lazplay
MINIO_SECRET_KEY=your-minio-secret-key

# Razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Set to false in production once real payments are live
ALLOW_MOCK_PAYMENTS=true

# Resend API Key for Email OTP (optional; defaults to mock code logging in dev)
RESEND_API_KEY=resend_key
