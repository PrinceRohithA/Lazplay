LAZPLAY_APP_ENV=development
PORT=2000
LAZPLAY_USE_MOCKS=true
LAZPLAY_API_PREFIXES=/api/v1,/v1
LAZPLAY_PUBLIC_WEB_URL=http://localhost:5173
LAZPLAY_PUBLIC_API_URL=http://localhost:2000/api/v1

LAZPLAY_AUTH_SECRET=replace-with-a-long-random-secret
LAZPLAY_ACCESS_TOKEN_TTL_SECONDS=900
LAZPLAY_REFRESH_TOKEN_TTL_SECONDS=604800

LAZPLAY_CACHE_HOME_SEGMENT_ID=
LAZPLAY_CACHE_MANIFEST_SEGMENT_ID=
LAZPLAY_CACHE_SIGNED_URL_SEGMENT_ID=
LAZPLAY_CACHE_METADATA_SEGMENT_ID=
LAZPLAY_CACHE_RATE_LIMIT_SEGMENT_ID=
LAZPLAY_CACHE_LAUNCHER_SEGMENT_ID=

LAZPLAY_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
LAZPLAY_R2_ACCESS_KEY_ID=
LAZPLAY_R2_SECRET_ACCESS_KEY=
LAZPLAY_R2_REGION=auto
LAZPLAY_R2_PRIVATE_GAME_BUCKET=lazplay-games-private
LAZPLAY_R2_PUBLIC_GAME_BUCKET=lazplay-games-public
LAZPLAY_R2_MEDIA_BUCKET=lazplay-media
LAZPLAY_R2_PUBLIC_GAME_PUBLIC_URL=https://cdn.lazplay.tech
LAZPLAY_R2_MEDIA_PUBLIC_URL=https://media.lazplay.tech
LAZPLAY_SIGNED_URL_TTL_SECONDS=900

LAZPLAY_RAZORPAY_KEY_ID=
LAZPLAY_RAZORPAY_KEY_SECRET=
LAZPLAY_RAZORPAY_WEBHOOK_SECRET=

LAZPLAY_RESEND_API_KEY=resend_key

