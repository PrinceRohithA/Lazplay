{
  "client": [
    {
      "name": "lazplay-client",
      "source": "client/dist",
      "ignore": [
        "**/node_modules/**",
        ".env",
        "*.log"
      ]
    }
  ],
  "appsail": [
    {
      "name": "lazplay-api",
      "source": "backend",
      "ignore": [
        "**/node_modules/**",
        ".env",
        ".env.*",
        "prisma/**",
        "src/routes/**",
        "src/services/distribution.js",
        "src/prisma.js",
        "scripts/init-db-with-psql.js",
        "scripts/test-catalyst.js",
        "scripts/zip-iac.ps1",
        "*.log"
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "targets": [
      "cacheInvalidator"
    ],
    "ignore": [
      "**/node_modules/**",
      ".env",
      "*.log"
    ]
  }
}
